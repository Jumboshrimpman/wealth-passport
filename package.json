{
  "name": "wealth-passport",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "start:api": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:api": "tsx --test server/api.test.ts",
    "test:admin": "tsx --test src/admin/dashboardLayout.test.ts",
    "test": "tsx --test server/api.test.ts src/admin/dashboardLayout.test.ts"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.9",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "@types/node": "^22.18.1",
    "vite": "^7.1.5"
  }
}
