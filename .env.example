# Publishable key only. Baked into the GitHub Pages bundle at build.
# Never put CLERK_SECRET_KEY here.
#
# Delivery is Pages: https://jumboshrimpman.github.io/wealth-passport/
# Set the same value as repo Actions secret VITE_CLERK_PUBLISHABLE_KEY
#
# Access is provisioned / invite-only. In Clerk Dashboard set Access mode to
# Invite-only (or Restrictions → disable public sign-up) and create users
# under Users (or Invitations). This client has no Sign-up UI.
#
# API (local SQLite client store). Used by `npm run dev`.
# API_PORT=8787
# DATABASE_PATH=data/wealthpass.sqlite
#
VITE_CLERK_PUBLISHABLE_KEY=

