# Publishable key only — this Vite app is a static GitHub Pages bundle.
# Never put CLERK_SECRET_KEY here. Copy to .env.local (gitignored).
#
# 1. Clerk Dashboard → create an application in the Hobby org
# 2. API Keys → Publishable key
# 3. Paste below, then: npm run dev
# 4. GitHub → Settings → Secrets and variables → Actions
#    → VITE_CLERK_PUBLISHABLE_KEY (same publishable value)
#
VITE_CLERK_PUBLISHABLE_KEY=
